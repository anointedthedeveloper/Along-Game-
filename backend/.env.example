# Port the API listens on
PORT=5000
# MongoDB connection string (use MongoDB Atlas in production)
MONGODB_URI=mongodb://127.0.0.1:27017/along
# Long random string used to sign JWTs (e.g. `openssl rand -hex 48`)
JWT_SECRET=
# JWT lifetime
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173
# Set to true to boot an in-memory MongoDB (development only, nothing persisted)
USE_MEMORY_DB=false
NODE_ENV=development
